#!/bin/sh
# Blocks a commit if it touches apps/backend and the backend test suite
# fails. No-ops for commits that don't touch the backend.
if git diff --cached --name-only | grep -q '^apps/backend/'; then
  echo "pre-commit: running backend tests (apps/backend touched)..."
  (cd apps/backend && .venv/bin/python3 -m pytest -q)
  status=$?
  if [ $status -ne 0 ]; then
    echo "pre-commit: backend tests failed, commit blocked."
    exit 1
  fi
fi
