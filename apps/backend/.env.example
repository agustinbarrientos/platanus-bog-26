# Copy to .env for local dev. .env is gitignored — never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Only browsers enforce CORS, so this does nothing for the Flutter app. It
# matters the day something runs in a browser. "*" is safe: the token is a
# header the client sets itself, never something a browser attaches on its own.
CORS_ORIGINS=*

# How long an issued token stays valid. Signing out revokes it immediately
# regardless, so this is not the thing protecting the account.
TOKEN_DAYS=90
MIN_PASSWORD_LENGTH=8

# Database. Set the real values in .env locally, and in the Render dashboard
# for the deployed service. If the password goes inside a connection URL, any
# @ : / ? # characters in it must be percent-encoded or the URL parser splits
# on them (@ becomes %40).
DATABASE_PASSWORD=
DATABASE_URL=

# console.anthropic.com -> API Keys. Only needed for POST
# /me/health-context/chat; every other endpoint works without it.
ANTHROPIC_API_KEY=
