# Copy to .env for local dev. .env is gitignored — never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API. "*" is fine until you use cookies.
CORS_ORIGINS=http://localhost:3000

# Database. Set the real values in .env locally, and in the Render dashboard
# for the deployed service. If the password goes inside a connection URL, any
# @ : / ? # characters in it must be percent-encoded or the URL parser splits
# on them (@ becomes %40).
DATABASE_PASSWORD=
DATABASE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Used only to locate the JWKS endpoint that verifies user tokens.
# No API key is needed: the backend reaches Postgres directly and only
# ever verifies already-signed JWTs, so no password touches this service.
SUPABASE_URL=
