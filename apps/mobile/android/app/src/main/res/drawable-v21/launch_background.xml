<?xml version="1.0" encoding="utf-8"?>
<!-- Arranque en frío: el mismo fondo de la app (MoiraiColors.bg) con la medusa
     del ícono en azul de marca, para que abrir la app no dé un salto de color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/moirai_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:tint="@color/moirai_brand"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
